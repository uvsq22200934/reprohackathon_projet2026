# Snakefile projet 1 :RNA-seq Staphylococcus aureus

ECHANTILLONS = [
    "SRR10379721",
    "SRR10379722",
    "SRR10379723",
    "SRR10379724",
    "SRR10379725",
    "SRR10379726"
]


ADAPTATEUR = "AGATCGGAAGAGC" # séquence adaptateur illumina
# peuvent se retrouver à la fin des read pendant le sequensage 
# >> ne font pas partie du génome bactérien il faut donc les retirer pour ne pas perturber l'alignement

#image du conteneur contenant cutatapt
IMAGE_CUTADAPT = "docker://quay.io/biocontainers/cutadapt:1.11--py35_0"

rule all: #tous les fichiers à produire
    input:
        "data/reference.fasta",
        "data/reference.gff",
        "data/kegg/kegg_gene_list.txt",
        "data/kegg/kegg_pathway_genes.txt",
        "data/kegg/kegg_brite_genes.txt",
        "data/kegg/ribosome_genes.txt",
        "data/kegg/aminoacyl_trna_genes.txt",
        "data/kegg/translation_factors_genes.txt",
        "data/kegg/translation_related_genes.txt",
        "data/kegg/translation_related_genes_gff.txt",
        "data/kegg/aureowiki/annotations_NCTC8325.tsv",
        "data/kegg/target_gene_annotations.tsv",
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        ),
        expand("data/fastq/{sample}.fastq.gz", sample=ECHANTILLONS),
        #TRIMMING
        expand("results/trimmed/{sample}.trimmed.fastq.gz", sample=ECHANTILLONS),
        #MAPPING
        expand("results/aligned/{sample}.bam", sample=ECHANTILLONS),
        expand("results/aligned/{sample}.bam.bai", sample=ECHANTILLONS),
        #COUNT
        expand("results/counts/{sample}.txt", sample=ECHANTILLONS),
        # DIFFERENTIAL EXPRESSION
        "results/deseq2/differential_expression.csv",
        "results/deseq2/normalized_counts.tsv",
        "results/deseq2/dds.rds",
        "results/deseq2/MA_plot_all_genes.pdf",
        "results/deseq2/MA_plot_translation_genes.pdf",
        "results/deseq2/sessionInfo.txt"


#Téléchargement du génome de référence ( curl est exécuté dans un conteneur pour maîtriser son environnement).
rule download_genome:
    output:
        "data/reference.fasta"
    shell:
        """
        mkdir -p data
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta" \
            -o {output}
        """


#téléchargement de l'annotation génomique (format GGF3)
rule download_annotation:
    output:
        "data/reference.gff"
    shell:
        """
        mkdir -p data
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=gff3&retmode=text" \
            -o {output}
        """

# Téléchargement des données KEGG
rule download_kegg:
    output:
        genes="data/kegg/kegg_gene_list.txt",
        pathways="data/kegg/kegg_pathway_genes.txt",
        brite="data/kegg/kegg_brite_genes.txt"
    shell:
        """
        mkdir -p data/kegg

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL https://rest.kegg.jp/list/sao \
            -o /work/{output.genes}

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL https://rest.kegg.jp/link/sao/pathway \
            -o /work/{output.pathways}

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL https://rest.kegg.jp/link/brite/sao \
            -o /work/{output.brite}
        """




# Téléchargement des annotations AureoWiki pour NCTC8325
rule download_aureowiki_annotations:
    output:
        "data/kegg/aureowiki/annotations_NCTC8325.tsv"
    shell:
        """
        mkdir -p data/kegg/aureowiki
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL --retry 5 --retry-all-errors \
                --connect-timeout 30 --max-time 300 \
                "https://aureowiki.med.uni-greifswald.de/extensions/AureoDownload/download.php" \
                --data-urlencode 'gsiStrainSelection[]=NCTC8325:0' \
                --data-urlencode 'gsiColumnSelection[]=oldLocusTag' \
                --data-urlencode 'gsiColumnSelection[]=newLocusTag' \
                --data-urlencode 'gsiColumnSelection[]=symbol' \
                --data-urlencode 'gsiColumnSelection[]=synonym' \
                --data-urlencode 'gsiColumnSelection[]=product' \
                --data-urlencode 'button=Download as Text (.tsv)' \
                -o /work/{output}
        """


# Extraction des annotations des six gènes ciblés
rule extract_target_gene_annotations:
    input:
        "data/kegg/aureowiki/annotations_NCTC8325.tsv"
    output:
        "data/kegg/target_gene_annotations.tsv"
    shell:
        """
        docker run --rm --user $(id -u):$(id -g) -v "$PWD:/work" -w /work workflow-utils \
            awk -F '\\t' '
            BEGIN {{
                OFS = "\\t"
                print "gene_id", "symbol", "description"
            }}
            NR > 1 && $1 ~ /^(SAOUHSC_00475|SAOUHSC_01234|SAOUHSC_01236|SAOUHSC_01246|SAOUHSC_01786|SAOUHSC_02489)$/ {{
                symbol = $4
                if ($1 == "SAOUHSC_00475") symbol = "pth"
                print $1, symbol, $6
            }}' /work/{input} > {output}
        """

# Extraction des gènes liés à la traduction depuis KEGG
rule extract_translation_genes:
    input:
        pathways="data/kegg/kegg_pathway_genes.txt",
        brite="data/kegg/kegg_brite_genes.txt"
    output:
        ribosome="data/kegg/ribosome_genes.txt",
        aminoacyl="data/kegg/aminoacyl_trna_genes.txt",
        factors="data/kegg/translation_factors_genes.txt"
    shell:
        """
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            sh -c '
                grep "path:sao03010" /work/{input.pathways} |
                cut -f2 | sed "s/^sao://" > /work/{output.ribosome}

                grep "path:sao00970" /work/{input.pathways} |
                cut -f2 | sed "s/^sao://" > /work/{output.aminoacyl}

                awk "$2 == \\"br:sao03012\\" {{
                    sub(/^sao:/, \\"\\", \\$1)
                    print \\$1
                }}" /work/{input.brite} > /work/{output.factors}
            '
        """



# Fusion des catégories de gènes liés à la traduction
rule merge_translation_genes:
    input:
        "data/kegg/ribosome_genes.txt",
        "data/kegg/aminoacyl_trna_genes.txt",
        "data/kegg/translation_factors_genes.txt"
    output:
        "data/kegg/translation_related_genes.txt"
    shell:
        """
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            sh -c 'cat {input} | sort -u > /work/{output}'
        """




# Filtrage des gènes KEGG présents dans l'annotation GFF
rule filter_translation_genes:
    input:
        genes="data/kegg/translation_related_genes.txt",
        gff="data/reference.gff"
    output:
        "data/kegg/translation_related_genes_gff.txt"
    shell:
        """
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            sh -c '
                grep -Ff /work/{input.genes} /work/{input.gff} |
                grep -oE "locus_tag=[^;]+" |
                cut -d= -f2 |
                sort -u > /work/{output}
            '
        """






rule index_genome: #ok fonctionne
    input:
        "data/reference.fasta"
    output:
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    shell:
        """
        mkdir -p results/bowtie_index
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            bowtie-0127 \
            bowtie-build {input} results/bowtie_index/genome
        """








# Téléchargement des fichiers FASTQ depuis SRA avec fasterq-dump.
# Compression des fichiers avec gzip dans le conteneur utils.
rule download_fastq:
    output:
        "data/fastq/{sample}.fastq.gz"
    shell:
        """
        mkdir -p data/fastq

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/sra-tools:3.0.3--h87f3376_0 \
            fasterq-dump {wildcards.sample} \
                --threads 2 --progress -O /work/data/fastq

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            gzip data/fastq/{wildcards.sample}.fastq
        """

rule trim_reads: #nettoyage des reads avec cutadapt
    input: "data/fastq/{sample}.fastq.gz"
    output: "results/trimmed/{sample}.trimmed.fastq.gz"
    params: adapter=ADAPTATEUR
    shell:
        """
        mkdir -p results/trimmed
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/cutadapt:1.11--py35_0 \
            cutadapt -q 20 -m 25 -a {params.adapter} \ # supprimer bases mauvaises qualité (-q 20) et reitrer les reads trop courts (-m25)
                -o {output} {input}
        """


rule align_reads: #alignement des reads nettoyéss sur le genome de ref 
    input:
        reads="results/trimmed/{sample}.trimmed.fastq.gz",
        index=expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    output:
        bam="results/aligned/{sample}.bam",
        bai="results/aligned/{sample}.bam.bai"
    threads: 2
    shell:
        """
        mkdir -p results/aligned

        #alignement avec Bowtie: creation du fichier SAM
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            bowtie-0127 \
            bash -o pipefail -c \
            'gzip -dc "/work/{input.reads}" | bowtie -q -p {threads} -S /work/results/bowtie_index/genome -' \
            > results/aligned/{wildcards.sample}.sam

                #tri et conversion du SAM en BAM avec Samtools
        
        rm -f results/aligned/{wildcards.sample}_tri_temp.*

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/samtools:1.13--h8c37831_0 \
            samtools sort -@ {threads} \
            -T "/work/results/aligned/{wildcards.sample}_tri_temp" \
            -o "/work/{output.bam}" \
            "/work/results/aligned/{wildcards.sample}.sam"


        #indexation du fichier BAM
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/samtools:1.13--h8c37831_0 \
            samtools index "/work/{output.bam}"

        # Suppression du fichier SAM intermediaire
        rm results/aligned/{wildcards.sample}.sam
        """



rule convert_gff_to_saf: #convertir le fichier d'annotation GFF en SAF pour que features coutns puissent l'utilsier
    input:
        "data/reference.gff"
    output:
        "data/reference.saf"
    shell:
        """
        awk -F '\\t' 'BEGIN {{OFS="\\t"; print "GeneID","Chr","Start","End","Strand"}}
        $3=="gene" {{
            split($9, a, ";")
            for (i in a) {{
                if (a[i] ~ /^locus_tag=/) {{
                    split(a[i], b, "=")
                    print b[2], $1, $4, $5, $7
                }}
            }}
        }}' {input} > {output}
        """

# Comptage des reads avec featureCounts
rule count_reads:
    input:
        bam="results/aligned/{sample}.bam",
        annotation="data/reference.saf"
    output:
        "results/counts/{sample}.txt"
    threads: 2
    shell:
        """
        mkdir -p results/counts

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            featurecounts-146p3 \
            featureCounts \
                -s 1 \
                -F SAF \
                -T {threads} \
                -a /work/{input.annotation} \
                -o /work/{output} \
                /work/{input.bam}
        """

#analyse différentielle avec DESeq2 
rule differential_expression:
    input:
        counts=expand("results/counts/{sample}.txt", sample=ECHANTILLONS),
        translation="data/kegg/translation_related_genes_gff.txt",
        aminoacyl="data/kegg/aminoacyl_trna_genes.txt",
        annotations="data/kegg/target_gene_annotations.tsv"
    output:
        csv="results/deseq2/differential_expression.csv",
        normalized="results/deseq2/normalized_counts.tsv",
        dds="results/deseq2/dds.rds",
        ma_all="results/deseq2/MA_plot_all_genes.pdf",
        ma_translation="results/deseq2/MA_plot_translation_genes.pdf",
        session="results/deseq2/sessionInfo.txt"


    shell:
        """
        mkdir -p results/deseq2
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            deseq2:1.16.1 \
            Rscript scripts/differential_expression.R
        """
