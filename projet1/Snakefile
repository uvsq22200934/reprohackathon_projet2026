
# Snakefile projet 1 :RNA-seq Staphylococcus aureus

ECHANTILLONS = [
    "SRR10379721",
    "SRR10379722",
    "SRR10379723",
    "SRR10379724",
    "SRR10379725",
    "SRR10379726"
]


ADAPTATEUR = "AGATCGGAAGAGC" # séquence adaptateur illumina
# peuvent se retrouver à la fin des read pendant le sequensage 
# >> ne font pas partie du génome bactérien il faut donc les retirer pour ne pas perturber l'alignement


rule all: #tous les fichiers à produire
    input:
        "data/reference.fasta",
        "data/reference.gff",
        "data/reference.saf",
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        ),
        expand("data/fastq/{sample}.fastq.gz", sample=ECHANTILLONS),
        #TRIMMING
        expand("results/trimmed/{sample}.trimmed.fastq.gz", sample=ECHANTILLONS),
        #MAPPING
        expand("results/aligned/{sample}.bam", sample=ECHANTILLONS),
        expand("results/aligned/{sample}.bam.bai", sample=ECHANTILLONS),
        #COUNT
        expand("results/counts/{sample}.txt", sample=ECHANTILLONS),
        # DIFFERENTIAL EXPRESSION
        "results/deseq2/differential_expression.csv",
        "results/deseq2/normalized_counts.tsv",
        "results/deseq2/dds.rds",
        "results/deseq2/MA_plot.pdf",
        "results/deseq2/MA_plot_translation.pdf",
        "results/deseq2/sessionInfo.txt"


#Téléchargement du génome de référence ( curl est exécuté dans un conteneur pour maîtriser son environnement).
rule download_genome:
    output:
        "data/reference.fasta"
    shell:
        """
        mkdir -p data
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta" \
            -o /work/{output}
        """


#téléchargement de l'annotation génomique (format GGF3)
rule download_annotation:
    output:
        "data/reference.gff"
    shell:
        """
        mkdir -p data
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=gff3&retmode=text" \
            -o /work/{output}
        """


rule index_genome: #ok fonctionne
    input:
        "data/reference.fasta"
    output:
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    shell:
        """
        mkdir -p results/bowtie_index
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            bowtie-0127 \
            bowtie-build /work/{input} /work/results/bowtie_index/genome
        """


# Téléchargement des fichiers FASTQ depuis SRA avec fasterq-dump.
# Compression des fichiers avec gzip dans le conteneur utils.
rule download_fastq:
    output:
        "data/fastq/{sample}.fastq.gz"
    shell:
        """
        mkdir -p data/fastq

        fasterq-dump {wildcards.sample} \
            --threads 2 \
            --progress \
            -O data/fastq

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            gzip /work/data/fastq/{wildcards.sample}.fastq
        """


rule trim_reads:
    input:
        "data/fastq/{sample}.fastq.gz"
    output:
        "results/trimmed/{sample}.trimmed.fastq.gz"
    params:
        adapter=ADAPTATEUR
    shell:
        """
        mkdir -p results/trimmed

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            cutadapt-1.11 \
            cutadapt -q 20 -m 25 -a {params.adapter} \
                -o /work/{output} /work/{input}
        """


# supprimer bases mauvaises qualité (-q 20) et reitrer les reads trop courts (-m25)
# La commande de trimming est déjà exécutée dans la règle trim_reads.


rule align_reads:
    input:
        reads="results/trimmed/{sample}.trimmed.fastq.gz",
        index=expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    output:
        bam="results/aligned/{sample}.bam",
        bai="results/aligned/{sample}.bam.bai"
    threads: 2
    shell:
        """
        mkdir -p results/aligned

        # Alignement avec Bowtie
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            bowtie-0127 \
            bash -o pipefail -c \
            'gzip -dc "/work/{input.reads}" | bowtie -q -p {threads} -S /work/results/bowtie_index/genome -' \
            > results/aligned/{wildcards.sample}.sam

        # Tri et conversion SAM vers BAM avec Samtools (Damona)
        samtools sort -@ {threads} \
            -T "results/aligned/{wildcards.sample}_tri_temp" \
            -o "{output.bam}" \
            "results/aligned/{wildcards.sample}.sam"

        # Indexation
        samtools index "{output.bam}"

        # Suppression du SAM intermédiaire
        rm results/aligned/{wildcards.sample}.sam
        """


rule convert_gff_to_saf: #convertir le fichier d'annotation GFF en SAF pour que features coutns puissent l'utilsier
    input:
        "data/reference.gff"
    output:
        "data/reference.saf"
    shell:
        """
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            workflow-utils \
            awk -F '\\t' 'BEGIN {{OFS="\\t"; print "GeneID","Chr","Start","End","Strand"}}
            $3=="gene" {{
                split($9, a, ";")
                for (i in a) {{
                    if (a[i] ~ /^locus_tag=/) {{
                        split(a[i], b, "=")
                        print b[2], $1, $4, $5, $7
                    }}
                }}
            }}' /work/{input} > /work/{output}
        """


# Comptage des reads avec featureCounts
rule count_reads:
    input:
        bam="results/aligned/{sample}.bam",
        annotation="data/reference.saf"
    output:
        "results/counts/{sample}.txt"
    threads: 2
    shell:
        """
        mkdir -p results/counts

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            featurecounts-146p3 \
            featureCounts \
                -s 1 \
                -F SAF \
                -T {threads} \
                -a /work/{input.annotation} \
                -o /work/{output} \
                /work/{input.bam}
        """


#analyse différentielle avec DESeq2 
rule differential_expression:
    input:
        expand("results/counts/{sample}.txt", sample=ECHANTILLONS)
    output:
        csv="results/deseq2/differential_expression.csv",
        normalized="results/deseq2/normalized_counts.tsv",
        dds="results/deseq2/dds.rds",
        ma="results/deseq2/MA_plot.pdf",
        session="results/deseq2/sessionInfo.txt",
        ma_translation="results/deseq2/MA_plot_translation.pdf"
    shell:
        """
        mkdir -p results/deseq2
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            deseq2:1.16.1 \
            Rscript scripts/differential_expression.R
        """
