# Snakefile - Projet 1 : RNA-seq Staphylococcus aureus

ECHANTILLONS = [
    "SRR10379721",
    "SRR10379722",
    "SRR10379723",
    "SRR10379724",
    "SRR10379725",
    "SRR10379726"
]

ADAPTATEUR = "AGATCGGAAGAGC"
IMAGE_CUTADAPT = "docker://quay.io/biocontainers/cutadapt:1.11--py35_0"

rule all:
    input:
        "data/reference.fasta",
        "data/reference.gff",
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        ),
        expand("data/fastq/{sample}.fastq.gz", sample=ECHANTILLONS),
        #TRIMMING
        expand("results/trimmed/{sample}.trimmed.fastq.gz", sample=ECHANTILLONS),
        #MAPPING
        expand("results/aligned/{sample}.bam", sample=ECHANTILLONS),
        expand("results/aligned/{sample}.bam.bai", sample=ECHANTILLONS),
        #COUNT
        expand("results/counts/{sample}.txt", sample=ECHANTILLONS)


rule download_genome: #ok fonctionne
    output:
        "data/reference.fasta"
    shell:
        """
        curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta" -o {output}
        """


rule download_annotation: #ok fonctionne
    output:
        "data/reference.gff"
    shell:
        """
        curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=gff3&retmode=text" -o {output}
        """


rule index_genome: #ok fonctionne
    input:
        "data/reference.fasta"
    output:
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    shell:
        """
        mkdir -p results/bowtie_index
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            bowtie-0127 \
            bowtie-build {input} results/bowtie_index/genome
        """


rule download_fastq:
    output:
        "data/fastq/{sample}.fastq.gz"
    shell:
        """
        mkdir -p data/fastq
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            quay.io/biocontainers/sra-tools:3.0.3--h87f3376_0 \
            fasterq-dump {wildcards.sample} \
                --threads 2 --progress -O /work/data/fastq
        gzip data/fastq/{wildcards.sample}.fastq
        """


rule trim_reads:
    input: "data/fastq/{sample}.fastq.gz"
    output: "results/trimmed/{sample}.trimmed.fastq.gz"
    params: adapter=ADAPTATEUR
    shell:
        """
        mkdir -p results/trimmed
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/cutadapt:1.11--py35_0 \
            cutadapt -q 20 -m 25 -a {params.adapter} \
                -o {output} {input}
        """

rule align_reads:
    input:
        reads="results/trimmed/{sample}.trimmed.fastq.gz",
        index=expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    output:
        bam="results/aligned/{sample}.bam",
        bai="results/aligned/{sample}.bam.bai"
    threads: 2
    shell:
        """
        mkdir -p results/aligned

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            bowtie-0127 \
            bash -o pipefail -c \
            'gzip -dc "/work/{input.reads}" | bowtie -q -p {threads} -S /work/results/bowtie_index/genome -' \
        | docker run --rm -i --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/samtools:1.13--h8c37831_0 \
            samtools sort -@ {threads} -o "/work/{output.bam}" -

        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            quay.io/biocontainers/samtools:1.13--h8c37831_0 \
            samtools index "/work/{output.bam}"
        """


rule convert_gff_to_saf:
    input:
        "data/reference.gff"
    output:
        "data/reference.saf"
    shell:
        """
        awk -F '\\t' 'BEGIN {{OFS="\\t"; print "GeneID","Chr","Start","End","Strand"}}
        $3=="gene" {{
            split($9, a, ";")
            for (i in a) {{
                if (a[i] ~ /^locus_tag=/) {{
                    split(a[i], b, "=")
                    print b[2], $1, $4, $5, $7
                }}
            }}
        }}' {input} > {output}
        """


#règle de comptage des reads avec featureCounts
rule count_reads:
    input:
        bam="results/aligned/{sample}.bam",
        annotation="data/reference.saf"
    output: "results/counts/{sample}.txt"
    threads: 2
    shell:
        """
        mkdir -p results/counts
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" -w /work \
            featurecounts-146p3 \
            featureCounts \
                -s 1 -F SAF -T {threads} \
                -a /work/{input.annotation} \
                -o /work/{output} \
                /work/{input.bam}
        """


