# Snakefile - Projet 1 : RNA-seq Staphylococcus aureus

ECHANTILLONS = [
    "SRR10379721",
    "SRR10379722",
    "SRR10379723",
    "SRR10379724",
    "SRR10379725",
    "SRR10379726"
]

ADAPTATEUR = "AGATCGGAAGAGC"
IMAGE_CUTADAPT = "docker://quay.io/biocontainers/cutadapt:1.11--py35_0"

rule all:
    input:
        "data/reference.fasta",
        "data/reference.gff",
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        ),
        expand("data/fastq/{sample}.fastq.gz", sample=ECHANTILLONS),
        #TRIMMING
        expand("results/trimmed/{sample}.trimmed.fastq.gz", sample=ECHANTILLONS),
        #MAPPING
        expand("results/aligned/{sample}.sam", sample=ECHANTILLONS),
        #COUNT
        expand("results/counts/{sample}.txt", sample=ECHANTILLONS)


rule download_genome:
    output:
        "data/reference.fasta"
    shell:
        """
        curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta" -o {output}
        """


rule download_annotation:
    output:
        "data/reference.gff"
    shell:
        """
        curl -fL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=gff3&retmode=text" -o {output}
        """


rule index_genome:
    input:
        "data/reference.fasta"
    output:
        expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt",
                 "rev.1.ebwt", "rev.2.ebwt"]
        )
    shell:
        """
        mkdir -p results/bowtie_index
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            bowtie-0127 \
            bowtie-build {input} results/bowtie_index/genome
        """


rule download_fastq:
    output:
        "data/fastq/{sample}.fastq.gz"
    params:
        sample="{sample}"
    shell:
        """
        mkdir -p data/fastq
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            sra-project \
            bash -c "fasterq-dump {params.sample} --threads 2 --progress -O data/fastq && gzip data/fastq/{params.sample}.fastq"
        """


rule trim_reads:
    input:
        "data/fastq/{sample}.fastq.gz"
    output:
        "results/trimmed/{sample}.trimmed.fastq.gz"
    params:
        adapter=ADAPTATEUR
    container:
        IMAGE_CUTADAPT
    shell:
        """
        mkdir -p results/trimmed
        cutadapt -q 20 -m 25 -a {params.adapter} \
            -o {output} {input}
        """
rule align_reads:
    input:
        reads="results/trimmed/{sample}.trimmed.fastq.gz",
        index=expand(
            "results/bowtie_index/genome.{ext}",
            ext=["1.ebwt", "2.ebwt", "3.ebwt", "4.ebwt", "rev.1.ebwt", "rev.2.ebwt"]
        )
    output:
        "results/aligned/{sample}.sam"
    shell:
        """
        mkdir -p results/aligned
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            bowtie-0127 \
            bowtie -S results/bowtie_index/genome <(zcat {input.reads}) > {output}
        """

#règle de comptage des reads avec featureCounts

rule count_reads:
    input:
        sam="results/aligned/{sample}.sam",
        annotation="data/reference.gff"
    output:
        "results/counts/{sample}.txt"
    shell:
        """
        mkdir -p results/counts
        docker run --rm --user $(id -u):$(id -g) \
            -v "$PWD:/work" \
            -w /work \
            quay.io/biocontainers/subread:2.0.1--h7132678_0 \
            featureCounts -t gene -g ID -a {input.annotation} -o {output} {input.sam}
        """
